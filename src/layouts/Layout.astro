---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  isHome = false,
} = Astro.props;

// Absolute URLs for canonical + social tags, derived from the current route.
const canonicalURL = new URL(Astro.url.pathname, SITE.url).href;
const ogImageURL = new URL(SITE.ogImage, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />

    <!-- This portfolio is shared by link only. Keep it out of search engines. -->
    <meta name="robots" content="noindex, nofollow, noarchive" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/images/man-face.webp" type="image/webp" />
    <link rel="apple-touch-icon" href="/images/man-face.webp" />
    <meta name="theme-color" content="#ffe83d" />

    <!-- The three weights used above the fold; the rest load on demand. -->
    <link rel="preload" href="/fonts/source-sans-3-v15-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-v15-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-sans-3-v15-latin-900.woff2" as="font" type="font/woff2" crossorigin />

    {isHome && <link rel="preload" href="/images/common-bg.svg" as="image" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    background: var(--yellow);
    color: var(--text-header);
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>

<script>
  // ---------------------------------------------------------------------
  // VIDEO AUTOPLAY, ONLY WHEN VISIBLE
  // Every <video data-autoplay> starts with preload="none". It only downloads
  // and plays once it scrolls near the viewport, and pauses when it leaves.
  // Users who prefer reduced motion see the poster frame instead.
  // ---------------------------------------------------------------------
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const autoplayVideos = Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]'));

  if (autoplayVideos.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && !reduceMotion) {
            video.play().catch(() => {
              /* autoplay can be blocked; the poster stays visible */
            });
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '200px 0px', threshold: 0.1 }
    );
    autoplayVideos.forEach((video) => observer.observe(video));
  }

  // ---------------------------------------------------------------------
  // SKILL CHIP ANIMATION when the skills list scrolls into view
  // ---------------------------------------------------------------------
  const skillLists = Array.from(document.querySelectorAll<HTMLElement>('.skills-list-animated'));
  if (skillLists.length && !reduceMotion && 'IntersectionObserver' in window) {
    const chipObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const chips = Array.from(entry.target.querySelectorAll<HTMLElement>('li'));
          chips.forEach((chip, i) => {
            if (entry.isIntersecting) {
              chip.style.animationDelay = `${i * 25}ms`;
              chip.classList.add('scale-animation');
            } else {
              chip.classList.remove('scale-animation');
            }
          });
        });
      },
      { threshold: 0.6 }
    );
    skillLists.forEach((list) => chipObserver.observe(list));
  }
</script>
