---
import { landingPages } from '../data/landing-pages';
import LandingPageCard from './LandingPageCard.astro';
---

<section class="landing-section" id="landing-pages" aria-labelledby="landing-title">
  <div class="landing-container container section-pad">
    <div class="title-div">
      <h2 class="title-after" id="landing-title">Landing pages</h2>
      <p>
        A landing page is built around one action. These are complete pages I designed and built myself, including
        the animations and mobile versions. Each one has a section-by-section walkthrough explaining what each
        part does.
      </p>
    </div>

    <div class="landing-list">
      {landingPages.map((page) => <LandingPageCard page={page} />)}
    </div>
  </div>
</section>

<style>
  .landing-section {
    display: flex;
    justify-content: center;
    min-width: 320px;
  }

  .landing-container {
    display: flex;
    flex-direction: column;
    row-gap: 3rem;
  }

  .landing-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media only screen and (min-width: 901px) {
    .landing-list {
      gap: 2.5rem;
    }
  }
</style>
