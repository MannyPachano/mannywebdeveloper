---
// A phone-shaped frame drawn in CSS around a portrait screenshot (6:13).
export interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  eager?: boolean;
}

const { src, alt, width, height, eager = false } = Astro.props;
---

<div class="phone">
  <div class="phone-screen">
    <img src={src} width={width} height={height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
</div>

<style>
  .phone {
    padding: 0.55rem;
    background: #111;
    border-radius: 2.2rem;
    box-shadow: var(--shadow-md), inset 0 0 0 2px #2c2c2c;
  }

  .phone-screen {
    aspect-ratio: 6 / 13;
    border-radius: 1.7rem;
    overflow: hidden;
    background: #f6f6f4;
  }

  .phone-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
