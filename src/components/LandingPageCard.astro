---
import type { LandingPage } from '../data/landing-pages';
import BrowserFrame from './BrowserFrame.astro';
import CompareSlider from './CompareSlider.astro';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  page: LandingPage;
}

const { page } = Astro.props;
const href = `/landing-page-${page.slug}`;
const phone = page.phones[0];
---

<article class="landing-card">
  <div class="landing-card-media">
    <div class="landing-card-stage">
      <div class="landing-card-browser">
        <BrowserFrame url={page.liveUrl}>
          <CompareSlider
            light={page.hero.light}
            dark={page.hero.dark}
            width={page.hero.width}
            height={page.hero.height}
            alt={page.hero.alt}
            label={`Compare the light and dark versions of the ${page.title} page`}
          />
        </BrowserFrame>
      </div>
      {phone && (
        <div class="landing-card-phone">
          <PhoneFrame src={phone.src} width={phone.width} height={phone.height} alt={phone.alt} />
        </div>
      )}
    </div>
    <p class="landing-card-hint">Drag the handle to compare the light and dark versions.</p>
  </div>

  <div class="landing-card-body">
    <p class="landing-card-meta">{page.kind} &middot; {page.year}</p>
    <h3 class="landing-card-title">
      <a href={href}>{page.title}</a>
    </h3>
    <p class="landing-card-summary" set:html={page.summary} />

    <ul class="skills-list skills-list-compact" aria-label="Tools and skills used">
      {page.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    <div class="landing-card-actions">
      <a class="button button-small" href={href}>See the walkthrough</a>
      <a class="text-link" href={page.liveUrl} target="_blank" rel="noopener noreferrer">
        Live page <span aria-hidden="true">&#8599;</span>
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
    </div>
  </div>
</article>

<style>
  .landing-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--gray-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .landing-card-media {
    padding: 1.25rem 1.25rem 0;
  }

  .landing-card-stage {
    display: flex;
    align-items: flex-end;
  }

  .landing-card-browser {
    flex: 1;
    min-width: 0;
  }

  /* The phone only shows beside the browser on wide screens. */
  .landing-card-phone {
    display: none;
  }

  .landing-card-hint {
    font-size: 0.85rem;
    color: var(--text-accent);
    margin-top: 0.75rem;
  }

  .landing-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.25rem 1.75rem;
  }

  .landing-card-meta {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .landing-card-title {
    margin: 0;
    line-height: 1.3;
  }

  .landing-card-title a {
    color: var(--text-header);
    text-decoration: none;
  }

  .landing-card-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .landing-card-summary {
    font-size: 1rem;
  }

  .landing-card .skills-list {
    margin-top: 0.25rem;
  }

  .landing-card-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .landing-card-actions .button-small {
    margin: 0;
    padding: 0.85rem 2.25rem;
  }

  @media only screen and (min-width: 901px) {
    .landing-card-media {
      padding: 2rem 2rem 0;
    }

    .landing-card-body {
      padding: 1.5rem 2rem 2.25rem;
    }
  }

  /* Wide screens: browser and phone on the left, text on the right. */
  @media only screen and (min-width: 1100px) {
    .landing-card {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
    }

    .landing-card-media {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2.5rem 2.25rem 2.25rem;
      border-right: 1px solid var(--gray-line);
    }

    .landing-card-phone {
      display: block;
      flex: 0 0 20%;
      margin-left: -8%;
      margin-bottom: -1.25rem;
      position: relative;
      z-index: 2;
    }

    .landing-card-hint {
      margin-top: 1.75rem;
    }

    .landing-card-body {
      padding: 2.25rem 2.25rem 2.5rem;
      justify-content: center;
    }
  }
</style>
