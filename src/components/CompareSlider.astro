---
// Two versions of one screen behind a draggable divider: image A sits
// underneath (seen on the left), image B on top clipped from the left (seen on
// the right), and a full-size range input moves the divider. Mouse, touch and
// keyboard all work because it is a real <input type="range">.
// Used for light vs dark (Rythm) and before vs after (redesigns).
export interface Props {
  a: string;
  b: string;
  labelA: string;
  labelB: string;
  width: number;
  height: number;
  /** Describes the screen shown (used for image A). */
  alt: string;
  label?: string;
  /** Load right away instead of lazily (for the first screen on a page). */
  eager?: boolean;
}

const {
  a,
  b,
  labelA,
  labelB,
  width,
  height,
  alt,
  label = `Compare the ${labelA.toLowerCase()} and ${labelB.toLowerCase()} versions`,
  eager = false,
} = Astro.props;

const loading = eager ? 'eager' : 'lazy';
---

<div class="compare" data-compare data-label-a={labelA} data-label-b={labelB}>
  <img class="compare-base" src={a} width={width} height={height} alt={alt} loading={loading} decoding="async" />
  <div class="compare-top" aria-hidden="true">
    <img src={b} width={width} height={height} alt="" loading={loading} decoding="async" />
  </div>
  <span class="compare-tag compare-tag-a" aria-hidden="true">{labelA}</span>
  <span class="compare-tag compare-tag-b" aria-hidden="true">{labelB}</span>
  <div class="compare-handle" aria-hidden="true">
    <span class="compare-knob">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M9 7l-5 5 5 5" />
        <path d="M15 7l5 5-5 5" />
      </svg>
    </span>
  </div>
  <input
    class="compare-range"
    type="range"
    min="0"
    max="100"
    step="1"
    value="50"
    aria-label={label}
    aria-valuetext={`50% ${labelA}, 50% ${labelB}`}
  />
</div>

<style>
  .compare {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    background: #0a0a0c;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }

  .compare img {
    display: block;
    width: 100%;
    height: auto;
  }

  .compare-top {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }

  .compare-top img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .compare-tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    pointer-events: none;
  }

  .compare-tag-a {
    left: 0.75rem;
    background: rgba(255, 255, 255, 0.92);
    /* White pill over the picture: the label stays dark in both themes. */
    color: var(--shot-fg);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
  }

  .compare-tag-b {
    right: 0.75rem;
    background: rgba(0, 0, 0, 0.78);
    color: var(--white);
  }

  .compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: var(--shot-bed);
    transform: translateX(-50%);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }

  .compare-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: var(--shadow-md);
  }

  /* The range input covers the whole picture, invisible, so any drag moves the line. */
  .compare-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    opacity: 0;
    cursor: ew-resize;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
  }

  .compare-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 2px;
    height: 100%;
  }

  .compare-range::-moz-range-thumb {
    width: 2px;
    height: 100%;
    border: 0;
  }

  .compare:has(.compare-range:focus-visible) .compare-knob {
    outline: 3px solid var(--yellow-dark);
    outline-offset: 3px;
  }
</style>

<script>
  // One listener per slider. The input value becomes the --pos custom property
  // that both the clip-path and the handle read.
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((box) => {
    const range = box.querySelector<HTMLInputElement>('.compare-range');
    if (!range) return;

    const labelA = box.dataset.labelA ?? 'A';
    const labelB = box.dataset.labelB ?? 'B';

    const apply = () => {
      const value = Math.min(100, Math.max(0, Number(range.value) || 0));
      box.style.setProperty('--pos', `${value}%`);
      range.setAttribute('aria-valuetext', `${value}% ${labelA}, ${100 - value}% ${labelB}`);
    };

    range.addEventListener('input', apply);
    apply();
  });
</script>
