---
import { SHOW_CLOX } from '../config';

// Work history. Keep it factual: employer, role, where, when.
const experience = [
  {
    org: 'TimeClick',
    role: 'Front-End Developer & Marketing Specialist',
    where: 'Remote for a Utah, US software company',
    when: '2024 to present',
  },
  ...(SHOW_CLOX
    ? [
        {
          org: 'Clox',
          role: 'Founder',
          where: 'B2B time-tracking SaaS for small field crews',
          when: '2026 to present',
        },
      ]
    : []),
  {
    org: 'nuVector LLC',
    role: 'Front-End Developer, then SEO & Marketing',
    where: 'US-based B2B software company',
    when: '2022 to 2025',
  },
  {
    org: 'Freelance',
    role: 'Web Design, Development & SEO',
    where: 'Clients across the US',
    when: '2019 to present',
  },
];

// Grouped so a reader can scan what kind of work I do, not just count tools.
const skillGroups = [
  {
    name: 'Development',
    items: ['HTML & CSS', 'JavaScript', 'TypeScript', 'Astro', 'Vue', 'WordPress', 'PHP', 'SQL', 'Git & GitHub', 'Netlify'],
  },
  {
    name: 'Marketing and SEO',
    items: ['Technical & local SEO', 'Google Analytics 4', 'Search Console', 'Google Business Profile', 'Email marketing', 'Conversion copywriting'],
  },
  {
    name: 'Integrations',
    items: ['REST APIs', 'Zoho CRM', 'Stripe & WooCommerce', 'Netlify Forms', 'Payroll and CRM exports'],
  },
  {
    name: 'Design and tooling',
    items: ['Performance optimization', 'Accessibility', 'Responsive design', 'Figma', 'SaaS product design', 'Video for web (ffmpeg, HLS)', 'AI-assisted development (Claude Code)'],
  },
];
---

<section class="about-section" id="about-section" aria-labelledby="about-title">
  <div class="about-container">
    <div class="title-div">
      <img
        class="about-photo"
        src="/images/manny-headshot.webp"
        width="800"
        height="500"
        alt="Manny Pachano crouching on a lawn, holding out a hand to two Canada geese"
        loading="lazy"
        decoding="async"
      />
      <h2 class="title-after" id="about-title">About me</h2>
      <p>
        I work remotely as the front-end developer and marketing specialist at TimeClick, a software company in Utah.
        I am also the web developer and SEO consultant for Universal Environmental Services, and I take on web
        design and SEO projects for other US clients.{SHOW_CLOX ? ' I also run my own product, Clox.' : ''}
        Outside of work I rock climb, train Brazilian jiu jitsu and travel.
      </p>
    </div>

    <div class="about-story">
      <h3>How I got here</h3>
      <p>
        I started building WordPress sites for small businesses while I was in college. Some of the work was paid and
        some was traded for things I needed at the time. As the projects got bigger, I moved from WordPress themes to
        writing sites from scratch.
      </p>
      <p>
        I taught myself JavaScript, PHP and design. From 2022 to 2025 I worked at nuVector, first as a front-end
        developer on their B2B web apps and later in SEO and marketing. Since 2024 I have been the front-end developer
        and marketing specialist at TimeClick, where I am responsible for the marketing website, including the design,
        the code, the CRM and checkout integrations, the SEO content and the email program.
      </p>
      <p>
        Since 2026 I have also been the web developer and SEO consultant for Universal Environmental Services, a used
        oil collection and recycling company in Georgia. I rebuilt their homepage and I run their ongoing SEO program.
      </p>
      {SHOW_CLOX && (
        <p>
          In 2026 I started Clox, a time-tracking app for small field crews in the trades. It has native iOS and
          Android apps, a web dashboard and a marketing site. I designed, built and market it myself.
        </p>
      )}
      <a class="button button-small" href="/#contact-section">Get in touch</a>
    </div>

    <div class="about-skills">
      <h3>Skills and tools</h3>
      {skillGroups.map((group) => (
        <div class="skill-group">
          <p class="eyebrow skill-group-name">{group.name}</p>
          <ul class="skills-list skills-list-animated" aria-label={`${group.name} skills`}>
            {group.items.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="about-experience">
      <h3>Experience</h3>
      <ol class="experience-list">
        {experience.map((job) => (
          <li class="experience-item">
            <div class="experience-head">
              <span class="experience-org">{job.org}</span>
              <span class="experience-when">{job.when}</span>
            </div>
            <span class="experience-role">{job.role}</span>
            <span class="experience-where">{job.where}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--surface-alt);
    display: flex;
    justify-content: center;
    min-width: 320px;
  }

  .about-container {
    display: flex;
    flex-direction: column;
    padding: 3rem 1rem 4rem;
    row-gap: 4rem;
    max-width: 78rem;
    width: 100%;
  }

  /* Landscape rather than a circle: the photo has to hold the whole scene,
     so a round crop would throw away either the geese or the person. The
     aspect ratio rather than a fixed height keeps it from overflowing a
     narrow phone and reserves the box before the image loads. */
  .about-photo {
    width: 22rem;
    max-width: 100%;
    /* height:auto is required: the height attribute on the img is a
       presentational hint, and without this it wins and aspect-ratio is
       ignored, which renders the box portrait instead of landscape. */
    height: auto;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    object-fit: cover;
    border: 4px solid var(--surface);
    box-shadow: var(--shadow-sm);
    margin-bottom: 0.5rem;
  }

  .about-story .button-small {
    margin-top: 2.5rem;
  }

  .skill-group + .skill-group {
    margin-top: 1rem;
  }

  .skill-group-name {
    font-size: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .experience-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .experience-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 5px solid var(--yellow);
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }

  .experience-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .experience-org {
    font-weight: 800;
    color: var(--text-header);
    font-size: 1.05rem;
  }

  .experience-when {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .experience-role {
    font-weight: 600;
    color: var(--text-subheader);
  }

  .experience-where {
    font-size: 0.95rem;
    color: var(--text-paragraph);
  }

  @media only screen and (min-width: 901px) {
    .about-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 5rem;
      row-gap: 4rem;
      padding-bottom: 6rem;
    }

    .about-container .title-div {
      grid-column: 1 / 3;
    }

    .about-experience {
      grid-column: 1 / 3;
    }

    .experience-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
