---
import { SHOW_CLOX } from '../config';

// Work history. Keep it factual: employer, role, where, when.
const experience = [
  {
    org: 'TimeClick',
    role: 'Front-End Developer & Marketing Specialist',
    where: 'Remote for a Utah, US software company',
    when: '2024 to present',
  },
  ...(SHOW_CLOX
    ? [
        {
          org: 'Clox',
          role: 'Founder',
          where: 'B2B time-tracking SaaS for small field crews',
          when: '2026 to present',
        },
      ]
    : []),
  {
    org: 'nuVector LLC',
    role: 'Front-End Developer, then SEO & Marketing',
    where: 'US-based B2B software company',
    when: '2022 to 2025',
  },
  {
    org: 'Freelance',
    role: 'Web Design, Development & SEO',
    where: 'Clients across the US',
    when: '2019 to present',
  },
];

// Grouped so a reader can scan what kind of work I do, not just count tools.
const skillGroups = [
  {
    name: 'Build',
    items: ['HTML & CSS', 'JavaScript', 'TypeScript', 'Astro', 'Vue', 'WordPress', 'PHP', 'SQL', 'Git & GitHub', 'Netlify'],
  },
  {
    name: 'Growth',
    items: ['Technical & local SEO', 'Google Analytics 4', 'Search Console', 'Google Business Profile', 'Email marketing', 'Conversion copywriting'],
  },
  {
    name: 'Integrations',
    items: ['REST APIs', 'Zoho CRM', 'Stripe & WooCommerce', 'Netlify Forms', 'Payroll and CRM exports'],
  },
  {
    name: 'Craft',
    items: ['Performance optimization', 'Accessibility', 'Responsive design', 'Figma', 'SaaS product design', 'Video for web (ffmpeg, HLS)', 'AI-assisted development (Claude Code)'],
  },
];
---

<section class="about-section" id="about-section" aria-labelledby="about-title">
  <div class="about-container">
    <div class="title-div">
      <h2 class="title-after" id="about-title">About me</h2>
      <p>
        I work remotely as the front-end developer and marketing specialist at TimeClick, a Utah software company,
        and take on select web and SEO projects for US clients{SHOW_CLOX ? '. I also run Clox, a time-tracking product of my own' : ''}.
        Off the clock: rock climbing, Brazilian jiu jitsu, and the occasional flight somewhere new.
      </p>
    </div>

    <div class="about-story">
      <h3>How I got here</h3>
      <p>
        I started building WordPress sites for small businesses in college, sometimes for pay and sometimes in trade
        for a room, a meal or a lesson. Every project pushed me further, until coding sites from scratch made more
        sense than fighting themes.
      </p>
      <p>
        I taught myself JavaScript, PHP and design, then spent three years at nuVector building the front end of
        B2B web apps before moving into SEO and marketing there. Since 2024 I have been the front-end developer and
        marketing specialist at TimeClick, where I own the marketing site end to end: design, code, CRM and checkout
        integrations, SEO content and the email program.
      </p>
      {SHOW_CLOX && (
        <p>
          In 2026 I founded Clox, a time-tracking app for small field crews in the trades: native iOS and Android apps,
          a web dashboard and the marketing site, all built and marketed by me. Running my own product is the best
          training I have had for building yours.
        </p>
      )}
      <a class="button button-small" href="/#contact-section">Get in touch</a>
    </div>

    <div class="about-skills">
      <h3>Skills and tools</h3>
      {skillGroups.map((group) => (
        <div class="skill-group">
          <p class="eyebrow skill-group-name">{group.name}</p>
          <ul class="skills-list skills-list-animated" aria-label={`${group.name} skills`}>
            {group.items.map((skill) => <li>{skill}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="about-experience">
      <h3>Experience</h3>
      <ol class="experience-list">
        {experience.map((job) => (
          <li class="experience-item">
            <div class="experience-head">
              <span class="experience-org">{job.org}</span>
              <span class="experience-when">{job.when}</span>
            </div>
            <span class="experience-role">{job.role}</span>
            <span class="experience-where">{job.where}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--gray-background);
    display: flex;
    justify-content: center;
    min-width: 320px;
  }

  .about-container {
    display: flex;
    flex-direction: column;
    padding: 3rem 1rem 4rem;
    row-gap: 4rem;
    max-width: 78rem;
    width: 100%;
  }

  .about-story .button-small {
    margin-top: 2.5rem;
  }

  .skill-group + .skill-group {
    margin-top: 1rem;
  }

  .skill-group-name {
    font-size: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .experience-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .experience-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: var(--white);
    border: 1px solid var(--gray-line);
    border-left: 5px solid var(--yellow);
    border-radius: 8px;
    padding: 1rem 1.25rem;
  }

  .experience-head {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .experience-org {
    font-weight: 800;
    color: var(--text-header);
    font-size: 1.05rem;
  }

  .experience-when {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .experience-role {
    font-weight: 600;
    color: var(--text-subheader);
  }

  .experience-where {
    font-size: 0.95rem;
    color: var(--text-paragraph);
  }

  @media only screen and (min-width: 901px) {
    .about-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 5rem;
      row-gap: 4rem;
      padding-bottom: 6rem;
    }

    .about-container .title-div {
      grid-column: 1 / 3;
    }

    .about-experience {
      grid-column: 1 / 3;
    }

    .experience-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
</style>
