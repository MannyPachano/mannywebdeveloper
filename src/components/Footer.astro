---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-in">
    <p>&copy; {year} Manny Pachano. Web designer, front-end developer and SEO consultant.</p>
    <p>Built with Astro and hand-written CSS. No trackers.</p>
  </div>
</footer>

<style>
  .site-footer {
    min-width: 320px;
    border-top: 1px solid var(--line);
    padding: 2.5rem 0 3rem;
    background-color: var(--page);
  }

  .footer-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-in p {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--text-accent);
  }
</style>
