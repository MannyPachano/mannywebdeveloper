---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const href = `/web-developer-project-${project.slug}`;
---

<article class:list={['project-card', { featured: project.featured }]}>
  <a class="project-card-media" href={href} tabindex="-1" aria-hidden="true">
    <div class:list={['media-frame', project.video.fit]}>
      <video
        muted
        playsinline
        loop
        preload="none"
        poster={project.video.poster}
        data-autoplay
      >
        {project.video.webm && <source src={project.video.webm} type="video/webm" />}
        <source src={project.video.mp4} type="video/mp4" />
      </video>
    </div>
  </a>

  <div class="project-card-body">
    <p class="project-card-meta">{project.role} &middot; {project.year}</p>
    <h3 class="project-card-title">
      <a href={href}>{project.title}</a>
    </h3>
    <p class="project-card-summary" set:html={project.summary} />

    <ul class="skills-list skills-list-compact" aria-label="Tools and skills used">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    <div class="project-card-actions">
      <a class="button button-small" href={href}>Case study</a>
      {project.liveUrl && (
        <a class="text-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
          Live site <span aria-hidden="true">&#8599;</span>
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--gray-line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .project-card-media {
    display: block;
  }

  .media-frame {
    aspect-ratio: 16 / 10;
    background: var(--gray-background);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--gray-line);
  }

  .media-frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .media-frame.contain video {
    object-fit: contain;
    padding: 3%;
  }

  .project-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1.5rem 1.75rem;
    flex: 1;
  }

  .project-card-meta {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-accent);
  }

  .project-card-title {
    margin: 0;
    line-height: 1.3;
  }

  .project-card-title a {
    color: var(--text-header);
    text-decoration: none;
  }

  .project-card-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }

  .project-card-summary {
    font-size: 1rem;
  }

  .project-card .skills-list {
    margin-top: 0.25rem;
  }

  .project-card-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .project-card-actions .button-small {
    margin: 0;
    padding: 0.85rem 2.25rem;
  }

  /* Featured card: full width, media beside the text on desktop */
  @media only screen and (min-width: 901px) {
    .project-card.featured {
      grid-column: 1 / -1;
      flex-direction: row;
    }

    .project-card.featured .project-card-media {
      flex: 1.35;
      min-width: 0;
    }

    .project-card.featured .media-frame {
      aspect-ratio: auto;
      height: 100%;
      min-height: 24rem;
      border-bottom: 0;
      border-right: 1px solid var(--gray-line);
    }

    .project-card.featured .project-card-body {
      flex: 1;
      padding: 2.25rem 2.25rem 2.5rem;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover,
    .project-card:focus-within {
      transform: none;
    }
  }
</style>
