<script>
  // One CSS timeline runs the whole strip. This script only moves that
  // timeline's clock when a scene button is pressed, keeps the caption and
  // the chip fill in step with it, parks it while it is off screen, and
  // handles the pause button.
  const root = document.getElementById('day-in-the-life');

  if (root) {
    const segs = Array.from(root.querySelectorAll<HTMLButtonElement>('.ditl-seg'));
    const cap = root.querySelector<HTMLElement>('.ditl-cap');
    const capTitle = root.querySelector<HTMLElement>('.ditl-cap-title');
    const capSub = root.querySelector<HTMLElement>('.ditl-cap-sub');
    const pauseButton = root.querySelector<HTMLButtonElement>('.ditl-pp');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const DUR = 44000; // the CSS timeline, in milliseconds
    const STAY = 6400; // he stays and does the thing
    const WALK = 2400; // he walks to the next scene
    const SEG = STAY + WALK;
    const NAMES = [
      'Hangout with my dog',
      'Train MMA',
      'Make some frontend magic',
      "There's a Willy's down the road",
      'On a clear starry night, fuhget about it',
    ];
    let current = 0;

    // The animations that run on the master timeline, found by name so this
    // does not depend on how a browser reports durations or subtree options.
    const ON_TIMELINE = /^ditl-(pan|pan-sky|pan-front|show-\w+|dog-away|fall|pull|reap|impact)$/;
    const timeline = (): Animation[] =>
      document.getAnimations().filter((a) => {
        const effect = a.effect as KeyframeEffect | null;
        if (!effect || !effect.target || !root.contains(effect.target)) return false;
        const name = 'animationName' in a ? (a as CSSAnimation).animationName : '';
        return ON_TIMELINE.test(name) || effect.getTiming().duration === DUR;
      });

    const clock = (): number => {
      const t = timeline()[0]?.effect?.getComputedTiming().localTime;
      return typeof t === 'number' ? t % DUR : 0;
    };

    const seek = (ms: number) => {
      timeline().forEach((a) => {
        a.currentTime = ms;
      });
    };

    const setScene = (i: number) => {
      if (i !== current) {
        current = i;
        cap?.classList.add('swap');
        window.setTimeout(() => {
          if (capTitle) capTitle.textContent = NAMES[i];
          if (capSub) capSub.textContent = `Scene ${i + 1} of ${NAMES.length}`;
          cap?.classList.remove('swap');
        }, 180);
      }
      segs.forEach((b) => b.setAttribute('aria-current', Number(b.dataset.i) === i ? 'true' : 'false'));
      root.setAttribute('data-scene', String(i));
    };

    segs.forEach((b) => {
      b.addEventListener('click', () => {
        const i = Number(b.dataset.i) || 0;
        if (!reduced) seek(i * SEG);
        setScene(i);
      });
    });

    pauseButton?.addEventListener('click', () => {
      const on = root.classList.toggle('paused');
      pauseButton.setAttribute('aria-pressed', String(on));
      pauseButton.setAttribute('aria-label', on ? 'Play' : 'Pause');
    });

    if (!reduced) {
      // Park everything while the strip is scrolled out of view.
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          (entries) => entries.forEach((e) => root.classList.toggle('offscreen', !e.isIntersecting)),
          { rootMargin: '80px' },
        ).observe(root);
      }

      // Keep the caption and the chip fill in step with the CSS clock. The
      // active chip fills through its stay and holds full through the walk.
      window.setInterval(() => {
        if (root.classList.contains('paused') || root.classList.contains('offscreen')) return;
        const t = clock();
        const i = Math.floor(t / SEG) % NAMES.length;
        const p = Math.min(1, (t - i * SEG) / STAY);
        segs.forEach((b, k) => {
          b.style.setProperty('--p', `${k < i ? 100 : k === i ? Math.round(p * 100) : 0}%`);
        });
        if (i !== current) setScene(i);
      }, 120);
    }
  }
</script>
