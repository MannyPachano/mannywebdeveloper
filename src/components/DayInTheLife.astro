<style is:global>
  /* ------------------------------------------------------------------------
     A day in the life
     One figure walks through five scenes on a 44 second loop. Everything is
     SVG and CSS; the script only moves the timeline's clock and the caption.

     Global on purpose: the SVG has a few hundred elements and Astro's scoped
     styles would stamp an attribute on every one of them. Every selector
     starts with .ditl, so nothing here reaches the rest of the page.
     ------------------------------------------------------------------------ */

  /* Panel colours. In the light theme the strip is ink on the page's own
     white surface, the same idea as the line drawing in the header. In the
     dark theme it flips to light ink on a bed a step darker than the page.
     Yellow stays yellow in both; what changes is how it is outlined. */
  .ditl {
    --ditl-bed: #ffffff;
    --ditl-bed-2: #f7f6f4;
    --ditl-tint: #edebe7;
    --ditl-bed-line: #dad7d1;
    --ditl-ink: #111111;
    --ditl-ink-2: #3f3b36;
    --ditl-ink-soft: #6e6963;
    --ditl-ink-far: #aaa59d;
    --ditl-skin: #f6f3ee;
    --ditl-accent-stroke: #111111;
    --ditl-accent-line: #a88f00;
    --ditl-flame-in: #fff9d9;
    --ditl-shadow: rgba(0, 0, 0, 0.12);
    --ditl-wash: 0.3;
    --ditl-screen-lo: 0.24;
    --ditl-screen-hi: 0.4;
    --ditl-glow-lo: 0.14;
    --ditl-glow-hi: 0.22;
    --ditl-focus: var(--on-accent);
    width: 100%;
    min-width: 0;
  }

  [data-theme='dark'] .ditl {
    --ditl-bed: #0f0e0d;
    --ditl-bed-2: #151412;
    --ditl-tint: #1b1917;
    --ditl-bed-line: #2c2926;
    --ditl-ink: #f3f1ee;
    --ditl-ink-2: #cfcac3;
    --ditl-ink-soft: #a8a29a;
    --ditl-ink-far: #5c5751;
    --ditl-skin: #2a2725;
    --ditl-accent-stroke: var(--yellow);
    --ditl-accent-line: var(--yellow);
    --ditl-flame-in: #fff6bf;
    --ditl-shadow: rgba(0, 0, 0, 0.35);
    --ditl-wash: 0.14;
    --ditl-screen-lo: 0.12;
    --ditl-screen-hi: 0.24;
    --ditl-glow-lo: 0.05;
    --ditl-glow-hi: 0.09;
    --ditl-focus: var(--yellow);
  }

  /* ---------------- the panel ---------------- */
  .ditl-panel {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: radial-gradient(120% 90% at 50% 20%, var(--ditl-bed-2) 0%, var(--ditl-bed) 70%);
    box-shadow: var(--shadow-sm);
  }

  .ditl-stage {
    position: relative;
  }

  .ditl-stage svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* On a phone the full strip would be a thin ribbon, so the stage shows
     the middle of each scene instead. Everything that matters is laid out
     inside that window; the edges only carry scenery. */
  @media (max-width: 700px) {
    .ditl-stage svg {
      aspect-ratio: 16 / 9;
    }
  }

  /* Fades the world in at both edges so scenes never cut off hard. */
  .ditl-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, var(--ditl-bed) 0%, transparent 9%, transparent 91%, var(--ditl-bed) 100%);
  }

  /* ---------------- caption and scene buttons ---------------- */
  .ditl-bar {
    display: grid;
    gap: 0.875rem;
    padding: 1rem 1.25rem 1.125rem;
    border-top: 1px solid var(--ditl-bed-line);
  }

  .ditl-cap {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .ditl-cap b {
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.2px;
    color: var(--ditl-ink);
    transition: opacity 0.35s var(--ease);
  }

  .ditl-cap span {
    font-size: 0.9rem;
    line-height: 1.4;
    letter-spacing: 0.4px;
    color: var(--ditl-ink-soft);
  }

  .ditl-cap.swap b {
    opacity: 0;
  }

  .ditl-segs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  /* The site's global `button` rule styles every button as the big yellow
     call to action. Each of those declarations is reset here on purpose. */
  .ditl-seg,
  .ditl-pp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 1.875rem;
    margin: 0;
    padding: 0 0.8rem;
    border: 1px solid var(--ditl-bed-line);
    border-radius: 99px;
    background: transparent;
    box-shadow: none;
    color: var(--ditl-ink-soft);
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .ditl-seg {
    position: relative;
    overflow: hidden;
  }

  /* Fills with the scene's progress. --p is set by the script. */
  .ditl-seg i {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--p, 0%);
    background: var(--yellow);
    opacity: 0.16;
    pointer-events: none;
  }

  .ditl-seg:hover,
  .ditl-pp:hover {
    border-color: var(--ditl-ink-soft);
    color: var(--ditl-ink);
    transform: none;
    scale: 1;
    box-shadow: none;
  }

  .ditl-seg[aria-current='true'] {
    border-color: var(--ditl-accent-stroke);
    color: var(--ditl-ink);
  }

  .ditl-pp {
    width: 1.875rem;
    padding: 0;
    margin-left: 0.375rem;
    color: var(--ditl-ink);
  }

  .ditl-pp svg {
    display: block;
    width: 10px;
    height: 11px;
    fill: currentColor;
  }

  .ditl-pp[aria-pressed='true'] .ditl-ico-pause,
  .ditl-pp:not([aria-pressed='true']) .ditl-ico-play {
    display: none;
  }

  /* The site's focus ring is a dark outline with a white halo. That works on
     the light panel as it is; on the dark bed the outline turns yellow,
     14.6:1 against it. */
  .ditl-seg:focus-visible,
  .ditl-pp:focus-visible {
    outline: 3px solid var(--ditl-focus);
    outline-offset: 2px;
    box-shadow: none;
  }

  @media (min-width: 720px) {
    .ditl-bar {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .ditl-segs {
      justify-content: flex-end;
    }
  }

  /* ---------------- strokes ---------------- */
  /* Three weights: s3 for the figure and what he touches, s2 for the near
     scenery, s1 for the far layer. Bodies are filled with the bed colour so
     lines behind him disappear where he stands. */
  .ditl-stage svg {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ditl-stage svg path,
  .ditl-stage svg circle,
  .ditl-stage svg rect,
  .ditl-stage svg ellipse {
    fill: none;
  }

  .ditl-stage .s3 { stroke: var(--ditl-ink); stroke-width: 3; }
  .ditl-stage .s2 { stroke: var(--ditl-ink-2); stroke-width: 1.9; }
  .ditl-stage .s1 { stroke: var(--ditl-ink-far); stroke-width: 1.4; }
  .ditl-stage svg .fillb { fill: var(--ditl-bed); }
  .ditl-stage svg .fillb2 { fill: var(--ditl-bed-2); }
  .ditl-stage svg .skin { fill: var(--ditl-skin); }
  .ditl-stage svg .shadow { fill: var(--ditl-shadow); stroke: none; }
  .ditl-stage .ground { stroke: var(--ditl-bed-line); stroke-width: 2.4; }
  .ditl-stage .sky path { stroke: var(--ditl-bed-line); stroke-width: 1.2; }
  .ditl-stage svg .mat { stroke: var(--ditl-ink-soft); stroke-width: 2.2; fill: var(--ditl-bed); }
  .ditl-stage .arc { stroke: var(--ditl-ink-far); stroke-width: 1.5; stroke-dasharray: 5 8; }
  .ditl-stage .grass { stroke: var(--ditl-ink-far); }
  .ditl-stage svg .accent-fill { fill: var(--yellow); stroke: var(--ditl-accent-stroke); }
  .ditl-stage .on-accent { stroke: #7a6600; stroke-width: 1.6; }
  .ditl-stage svg .accent-screen { fill: var(--yellow); fill-opacity: var(--ditl-screen-lo); stroke: var(--ditl-accent-stroke); stroke-width: 1.2; }
  .ditl-stage .code { stroke: var(--ditl-accent-line); stroke-opacity: 0.9; }
  .ditl-stage svg .tortilla { fill: var(--yellow); fill-opacity: var(--ditl-wash); stroke: var(--ditl-accent-stroke); stroke-width: 2.4; }
  .ditl-stage svg .belt { fill: var(--yellow); stroke: var(--ditl-accent-stroke); stroke-width: 1.4; }
  .ditl-stage .belt-end { stroke: var(--ditl-accent-stroke); stroke-width: 2.2; }
  .ditl-stage svg .flame-in { fill: var(--ditl-flame-in); stroke: none; }
  .ditl-stage svg .eye { fill: var(--ditl-ink); }
  .ditl-stage svg .nfill { fill: var(--ditl-ink-2); }
  .ditl-stage svg .star { fill: var(--ditl-ink-soft); stroke: none; }
  .ditl-stage .leaf { stroke: var(--ditl-ink-2); }

  .ditl-stage svg .wall { fill: var(--ditl-tint); stroke: none; }
  .ditl-stage svg text { font-family: inherit; font-weight: 800; fill: var(--ditl-ink-far); stroke: none; }
  .ditl-stage svg .sign-near { fill: var(--ditl-ink-2); }
  .ditl-stage svg .sign-front { fill: var(--ditl-ink-soft); }
  .ditl-stage svg .bulb { fill: var(--ditl-ink-2); stroke: none; }
  .ditl-stage svg .glow { fill: var(--yellow); fill-opacity: var(--ditl-glow-lo); stroke: none; }
  .ditl-stage .belt-white { stroke: var(--ditl-ink-2); stroke-width: 3.6; }
  .ditl-stage svg .foil { fill: var(--ditl-tint); stroke: var(--ditl-ink-2); stroke-width: 1.9; }
  .ditl-stage .foilline { stroke: var(--ditl-ink-soft); stroke-width: 1.3; }
  .ditl-stage svg .fill-dot { fill: var(--ditl-ink-2); stroke: none; }
  .ditl-stage .fill-line { stroke: var(--ditl-ink-2); stroke-width: 1.6; }
  .ditl-stage svg .nose { fill: var(--ditl-ink); }
  .ditl-stage .impact { stroke: var(--ditl-ink-2); }
  .ditl-stage .bush { stroke: var(--ditl-ink-2); }

  /* Parts that only show for a moment start hidden; their keyframes bring them in. */
  .ditl-stage .ball-fly,
  .ditl-stage .ball-mouth,
  .ditl-stage .mouth-b,
  .ditl-stage .impact { opacity: 0; }

  /* Six poses stand on the same spot; the timeline shows one at a time. */
  .ditl-stage .pose { visibility: hidden; }
  .ditl-stage .pose-throw { visibility: visible; }

  /* ============ one 44 s timeline drives everything ============ */
  /* 5 stays of 6.4 s and 5 walks of 2.4 s. The world holds during a stay and glides during a walk; the same percentages switch which pose is visible. */
  @keyframes ditl-pan { 0%, 14.545% { transform: translateX(0px); } 20%, 34.545% { transform: translateX(-960px); } 40%, 54.545% { transform: translateX(-1920px); } 60%, 74.545% { transform: translateX(-2880px); } 80%, 94.545% { transform: translateX(-3840px); } 100% { transform: translateX(-4800px); } }
  /* the distant hills move at 40 percent and the foreground at 125 percent, which is what sells the depth */
  @keyframes ditl-pan-sky { 0%, 14.545% { transform: translateX(0px); } 20%, 34.545% { transform: translateX(-384px); } 40%, 54.545% { transform: translateX(-768px); } 60%, 74.545% { transform: translateX(-1152px); } 80%, 94.545% { transform: translateX(-1536px); } 100% { transform: translateX(-1920px); } }
  @keyframes ditl-pan-front { 0%, 14.545% { transform: translateX(0px); } 20%, 34.545% { transform: translateX(-1200px); } 40%, 54.545% { transform: translateX(-2400px); } 60%, 74.545% { transform: translateX(-3600px); } 80%, 94.545% { transform: translateX(-4800px); } 100% { transform: translateX(-6000px); } }
  .ditl-stage .pan, .ditl-stage .pan-far, .ditl-stage .pan-sky, .ditl-stage .pan-front { animation: ditl-pan 44s cubic-bezier(0.45, 0, 0.2, 1) infinite; }
  .ditl-stage .pan-sky { animation-name: ditl-pan-sky; }
  .ditl-stage .pan-front { animation-name: ditl-pan-front; }
  @keyframes ditl-show-walk { 0% { visibility: hidden; } 14.545% { visibility: visible; } 20% { visibility: hidden; } 34.545% { visibility: visible; } 40% { visibility: hidden; } 54.545% { visibility: visible; } 60% { visibility: hidden; } 74.545% { visibility: visible; } 80% { visibility: hidden; } 94.545% { visibility: visible; } 100% { visibility: visible; } }
  @keyframes ditl-show-throw { 0% { visibility: visible; } 14.545% { visibility: hidden; } 100% { visibility: hidden; } }
  @keyframes ditl-show-grapple { 0% { visibility: hidden; } 20% { visibility: visible; } 34.545% { visibility: hidden; } 100% { visibility: hidden; } }
  @keyframes ditl-show-type { 0% { visibility: hidden; } 40% { visibility: visible; } 54.545% { visibility: hidden; } 100% { visibility: hidden; } }
  @keyframes ditl-show-eat { 0% { visibility: hidden; } 60% { visibility: visible; } 74.545% { visibility: hidden; } 100% { visibility: hidden; } }
