---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="projects-section" id="project-section" aria-labelledby="projects-title">
  <div class="projects-container">
    <div class="title-div">
      <h2 class="title-after" id="projects-title">Projects</h2>
      <p>
        Here's what I've been building lately. Each one has a short case study: the problem, what I built, and what it changed.
        If it looks like a fit, the contact form is at the bottom of the page. I reply fast.
      </p>
    </div>

    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>

<style>
  .projects-section {
    display: flex;
    justify-content: center;
    min-width: 320px;
  }

  .projects-container {
    display: flex;
    flex-direction: column;
    padding: 3rem 1rem 4rem;
    row-gap: 3rem;
    max-width: 78rem;
    width: 100%;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media only screen and (min-width: 901px) {
    .projects-container {
      padding-bottom: 6rem;
    }

    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
</style>
