---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

// On phones, show this many cards first and a "show the rest" button.
const INITIAL_MOBILE_CARDS = 5;
const hiddenCount = Math.max(projects.length - INITIAL_MOBILE_CARDS, 0);
---

<section class="projects-section" id="project-section" aria-labelledby="projects-title">
  <div class="projects-container container section-pad">
    <div class="title-div">
      <h2 class="title-after" id="projects-title">Recent projects</h2>
      <p>
        These are projects I have worked on recently. Each case study shows what the project needed, what I built
        and why I made the decisions I did. If you want to work together, the contact form is at the bottom of
        the page.
      </p>
    </div>

    <div class="projects-grid" id="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>

    {hiddenCount > 0 && (
      <div class="show-all-wrap" id="show-all-wrap">
        <button class="button button-small button-secondary" id="show-all-projects" type="button" aria-controls="projects-grid" aria-expanded="false">
          Show {hiddenCount} more {hiddenCount === 1 ? 'project' : 'projects'}
        </button>
      </div>
    )}
  </div>
</section>

<style>
  .projects-section {
    display: flex;
    justify-content: center;
    min-width: 320px;
  }

  .projects-container {
    display: flex;
    flex-direction: column;
    row-gap: 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Desktop shows every card; the button only exists for phones. */
  .show-all-wrap {
    display: none;
    justify-content: center;
    margin-top: -1rem;
  }

  .show-all-wrap .button {
    margin: 0;
  }

  @media only screen and (max-width: 900px) {
    .projects-grid:not(.expanded) .project-card:nth-child(n + 6) {
      display: none;
    }

    .show-all-wrap {
      display: flex;
    }

    .show-all-wrap[hidden] {
      display: none;
    }
  }

  @media only screen and (min-width: 901px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
</style>

<script>
  const grid = document.getElementById('projects-grid');
  const wrap = document.getElementById('show-all-wrap');
  const button = document.getElementById('show-all-projects');

  button?.addEventListener('click', () => {
    if (!grid) return;
    grid.classList.add('expanded');
    button.setAttribute('aria-expanded', 'true');
    if (wrap) wrap.hidden = true;
    // Move focus to the first newly revealed card so keyboard users land on it.
    const revealed = grid.querySelectorAll<HTMLElement>('.project-card')[5];
    const link = revealed?.querySelector<HTMLElement>('.project-card-title a');
    link?.focus({ preventScroll: false });
  });
</script>
