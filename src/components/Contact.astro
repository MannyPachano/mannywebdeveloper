---
// Contact form handled by Netlify Forms.
// Requirements: static build output (astro.config output: 'static') and
// "Enable form detection" switched on in Netlify > Site configuration > Forms.
---

<section class="h-sec h-sec-alt" id="contact-section" aria-labelledby="contact-title">
  <div class="container h-contact">
    <div>
      <h2 class="h-h2" id="contact-title">Contact me about a project or a role</h2>
      <p class="h-p h-contact-intro">Tell me what you need built or fixed, and I will reply by email.</p>
      <ul class="h-contact-links">
        <li>
          <span>LinkedIn</span>
          <a class="h-link" href="https://www.linkedin.com/in/manny-pachano" target="_blank" rel="noopener noreferrer">
            manny-pachano<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <span>Resume</span>
          <a class="h-link" href="/files/Manny_Pachano_Resume.pdf">Download PDF</a>
        </li>
      </ul>
    </div>

    <form
      name="contact"
      method="POST"
      action="/thanks"
      data-netlify="true"
      netlify-honeypot="bot-field"
      id="contact-form"
      class="h-form"
    >
      <!-- Required by Netlify for forms rendered by frameworks -->
      <input type="hidden" name="form-name" value="contact" />

      <!-- Honeypot: hidden from people, tempting for bots -->
      <p class="visually-hidden" aria-hidden="true">
        <label>
          Leave this field empty
          <input name="bot-field" tabindex="-1" autocomplete="off" />
        </label>
      </p>

      <div class="h-form-row">
        <div class="h-field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>
        <div class="h-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required />
        </div>
      </div>

      <div class="h-field">
        <label for="company">Company or website (optional)</label>
        <input type="text" id="company" name="company" autocomplete="organization" />
      </div>

      <div class="h-field">
        <label for="message">What do you need?</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <div>
        <button class="h-btn h-btn-primary" type="submit">Send message</button>
      </div>
    </form>
  </div>
</section>
