---
// Site header: fixed nav, mobile overlay menu, and the cursor trail (desktop only).
const links = [
  { href: '/', label: 'Home' },
  { href: '/#about-section', label: 'About' },
  { href: '/#project-section', label: 'Projects' },
  { href: '/#landing-pages', label: 'Landing pages' },
  { href: '/#contact-section', label: 'Contact' },
];

const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <nav class="site-nav" id="site-nav" aria-label="Main">
    <div class="navigation-content">
      <a href="/" class="logo" aria-label="Manny Pachano, back to home">
        <img src="/images/man-face.webp" width="24" alt="" decoding="async" />
        <span class="logo-text">MANNY PACHANO</span>
      </a>

      <ul class="nav-links">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isHome && link.href === '/' ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="nav-right">
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to the dark theme">
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>

        <button
          class="burger-menu"
          id="burger"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <span class="bar topBar"></span>
          <span class="bar btmBar"></span>
        </button>
      </div>
    </div>
  </nav>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul>
      {links.map((link) => (
        <li class="mobile-menu-item">
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<div class="cursor-trail" id="cursor-trail" aria-hidden="true">
  {Array.from({ length: 10 }).map(() => <div class="circle"></div>)}
</div>

<style>
  /* Cursor trail stays invisible until the mouse actually moves. */
  .cursor-trail:not(.is-active) .circle {
    opacity: 0;
  }

  /* Spacer so page content starts below the fixed bar. */
  .site-header {
    height: var(--nav-height);
  }

  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    padding: 1rem 1rem;
    background-color: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--nav-line);
    transition: background-color 0.3s var(--ease);
  }

  .navigation-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 78rem;
    margin: 0 auto;
    min-height: 3rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: transform 0.15s var(--ease);
  }

  .logo:hover {
    transform: translateY(-3px);
  }

  .logo img {
    width: 24px;
    height: auto;
  }

  .logo-text {
    font-weight: 700;
    color: var(--text-paragraph);
    letter-spacing: 1.5px;
    font-size: 18px;
    transition: color 0.3s var(--ease);
  }

  .nav-links {
    display: none;
    gap: clamp(1rem, 3vw, 2.5rem);
    list-style: none;
  }

  .nav-links a {
    display: inline-block;
    padding: 0.4rem 0.15rem;
    color: var(--text-paragraph);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.8px;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: transform 0.15s var(--ease), border-color 0.15s var(--ease);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a[aria-current='page'] {
    border-bottom-color: var(--yellow);
  }

  .nav-links a:hover {
    transform: translateY(-3px);
  }

  /* Burger button (mobile) */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Theme toggle. Resets the global button styles, same as .burger-menu does. */
  .theme-toggle {
    width: 2.5rem;
    height: 2.5rem;
    min-width: 2.5rem;
    padding: 0;
    margin: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    background-color: var(--surface);
    color: var(--text-subheader);
    box-shadow: none;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .theme-toggle:hover {
    transform: none;
    scale: 1;
    box-shadow: none;
    background-color: var(--surface-alt);
    color: var(--text-header);
  }

  /* Scoped styles outrank global.css, so the focus ring has to be restored
     here. Without it the toggle has no visible focus in dark theme: the dark
     outline measures 1.22:1 against its own surface. */
  .theme-toggle:focus-visible {
    box-shadow: 0 0 0 6px var(--white);
  }

  .theme-toggle svg {
    display: block;
  }

  /* One icon at a time: the moon offers dark, the sun offers light. */
  .theme-toggle .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }

  .site-nav.menu-open .theme-toggle {
    background-color: transparent;
    border-color: rgba(255, 255, 255, 0.35);
    color: var(--white);
  }

  .burger-menu {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background-color: var(--burger-bg);
    border: 0;
    padding: 0;
    margin: 0;
    box-shadow: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    transition: background-color 0.3s var(--ease);
  }

  .burger-menu:hover {
    transform: none;
    scale: 1;
    box-shadow: none;
  }

  .bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--burger-bar);
    transition: transform 0.3s cubic-bezier(0.4, 0.01, 0.165, 0.99), background-color 0.3s var(--ease);
  }

  /* Open state: bar goes dark, burger becomes an X */
  .menu-open .site-nav,
  .site-nav.menu-open {
    background-color: var(--overlay);
    border-bottom-color: transparent;
  }

  .site-nav.menu-open .logo-text {
    color: var(--white);
  }

  .site-nav.menu-open .burger-menu {
    background-color: var(--white);
  }

  .site-nav.menu-open .bar {
    background: var(--overlay);
  }

  .site-nav.menu-open .topBar {
    transform: translateY(3.5px) rotate(45deg);
  }

  .site-nav.menu-open .btmBar {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Full-screen mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background-color: var(--overlay);
    padding: calc(var(--nav-height) + 1.5rem) 1.5rem 2rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    animation: menu-in 0.25s var(--ease);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .mobile-menu ul {
    list-style: none;
    text-align: center;
    width: 100%;
    max-width: 24rem;
    margin: auto;
  }

  .mobile-menu-item a {
    display: block;
    padding: 1.5rem;
    font-size: 1.4rem;
    color: var(--white);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-decoration: none;
    border-bottom: 1px solid rgba(254, 249, 246, 0.3);
  }

  .mobile-menu-item a:hover,
  .mobile-menu-item a:focus-visible {
    color: var(--yellow);
  }

  @media only screen and (min-width: 601px) {
    .site-nav {
      padding: 1rem 1.5rem;
    }
  }

  /* Five links need the room: the full link row starts at 901px, below that the burger menu. */
  @media only screen and (min-width: 901px) {
    .nav-links {
      display: flex;
    }

    .burger-menu,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  // ---------------------------------------------------------------------
  // THEME TOGGLE
  // /theme.js has already set data-theme on <html> before this runs. This
  // only handles the click and remembers the choice.
  // ---------------------------------------------------------------------
  const THEME_KEY = 'theme';
  const root = document.documentElement;
  const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement | null;

  function currentTheme(): 'light' | 'dark' {
    return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function syncToggleLabel() {
    if (!themeToggle) return;
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    themeToggle.setAttribute('aria-label', `Switch to the ${next} theme`);
  }

  syncToggleLabel();
  // theme.js fires this when the operating system flips and no choice is stored.
  root.addEventListener('themechange', syncToggleLabel);

  themeToggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem(THEME_KEY, next);
    } catch (e) {
      // Blocked storage: the choice lasts for this page only.
    }
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'dark' ? '#1a1917' : '#ffe83d');
    syncToggleLabel();
  });

  // ---------------------------------------------------------------------
  // MOBILE MENU
  // ---------------------------------------------------------------------
  const nav = document.getElementById('site-nav');
  const burger = document.getElementById('burger') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');

  const behind = [document.getElementById('main'), document.querySelector('footer')];

  function setMenu(open: boolean) {
    if (!nav || !burger || !menu) return;
    const wasOpen = burger.getAttribute('aria-expanded') === 'true';
    nav.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    menu.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');

    /* Everything behind the overlay is unreachable while it is open, focus
       moves into the menu, and closing puts it back on the burger. The wasOpen
       guard stops a viewport resize stealing focus when no menu was showing. */
    behind.forEach((el) => {
      if (!el) return;
      if (open) el.setAttribute('inert', '');
      else el.removeAttribute('inert');
    });
    if (open) menu.querySelector('a')?.focus();
    else if (wasOpen) burger.focus();
  }

  burger?.addEventListener('click', () => {
    setMenu(burger.getAttribute('aria-expanded') !== 'true');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenu(false);
  });

  // Close the overlay if the viewport grows past the mobile breakpoint.
  const desktopQuery = window.matchMedia('(min-width: 901px)');
  desktopQuery.addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });

  // ---------------------------------------------------------------------
  // CURSOR TRAIL (desktop, fine pointer, no reduced-motion preference)
  // The animation loop only runs while the cursor is moving, then stops.
  // ---------------------------------------------------------------------
  const trail = document.getElementById('cursor-trail');
  const circles = Array.from(document.querySelectorAll<HTMLElement>('.cursor-trail .circle'));
  const finePointer = window.matchMedia('(pointer: fine)').matches;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (circles.length && finePointer && !prefersReducedMotion) {
    const cursor = { x: -100, y: -100 };
    const positions = circles.map(() => ({ x: -100, y: -100 }));
    let frameId = 0;
    let idleFrames = 0;

    function frame() {
      let x = cursor.x;
      let y = cursor.y;
      let moving = false;

      circles.forEach((circle, index) => {
        circle.style.left = `${x - 12}px`;
        circle.style.top = `${y - 12}px`;
        circle.style.transform = `scale(${(circles.length - index) / circles.length})`;
        positions[index] = { x, y };

        const next = positions[index + 1] || positions[0];
        const dx = (next.x - x) * 0.3;
        const dy = (next.y - y) * 0.3;
        if (Math.abs(dx) > 0.1 || Math.abs(dy) > 0.1) moving = true;
        x += dx;
        y += dy;
      });

      if (moving || idleFrames++ < 30) {
        frameId = requestAnimationFrame(frame);
      } else {
        frameId = 0;
      }
    }

    window.addEventListener(
      'mousemove',
      (event) => {
        cursor.x = event.clientX;
        cursor.y = event.clientY;
        idleFrames = 0;
        trail?.classList.add('is-active');
        if (!frameId) frameId = requestAnimationFrame(frame);
      },
      { passive: true }
    );
  }
</script>
