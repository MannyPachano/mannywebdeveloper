<section class="hero-section" id="hero" aria-labelledby="h1-hero">
  <div class="hero-content">
    <h1 id="h1-hero">Hey, I'm Manny Pachano</h1>
    <p class="lede hero-lede">
      I'm a front-end developer and marketing specialist. I build websites for software companies and small
      businesses, and I handle the SEO, email and CRM work that goes with them. I've been doing this for US
      clients since 2019.
    </p>
    <div class="hero-actions">
      <a class="button" href="/#project-section">See my work</a>
      <a class="button button-secondary" href="/#contact-section">Get in touch</a>
    </div>
    <p class="hero-proof">
      Recent work: TimeClick, Universal Environmental Services, nuVector and several small businesses in the US.
    </p>
  </div>

  <!-- Easter egg: hover the headline to reveal the photo behind it. -->
  <div class="manny-img" id="manny-img" aria-hidden="true"></div>

  <div class="mouse-section" aria-hidden="true">
    <div class="mouse"></div>
  </div>
</section>

<style>
  .hero-section {
    height: calc(100vh - var(--nav-height));
    min-height: 36.5rem;
    background: linear-gradient(to right, rgba(245, 245, 245, 0.8), rgba(245, 245, 245, 0.8)), url(/images/common-bg.svg);
    position: relative;
    min-width: 320px;
  }

  .hero-content {
    text-align: center;
    width: 92%;
    max-width: 45rem;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .hero-lede {
    margin: 0 auto;
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 2.75rem;
  }

  .hero-actions .button {
    margin: 0;
    padding: 1rem 3rem;
    font-size: 18px;
  }

  @media only screen and (max-width: 600px) {
    .hero-actions .button {
      width: 100%;
      max-width: 22rem;
    }
  }

  .hero-proof {
    margin: 2rem auto 0;
    max-width: 34rem;
    font-size: 0.9rem;
    letter-spacing: 0.6px;
    color: var(--text-accent);
  }

  .mouse-section {
    position: absolute;
    bottom: 3%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 0;
    transition: opacity 0.3s var(--ease);
  }

  .hero-section.scrolled .mouse-section {
    opacity: 0;
  }

  .mouse {
    width: 25px;
    height: 40px;
    border: 2px solid #333;
    border-radius: 60px;
    position: relative;
    overflow: hidden;
  }

  .mouse::before {
    content: '';
    width: 5px;
    height: 5px;
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    background-color: #333;
    border-radius: 50%;
    opacity: 1;
    animation: scroll 1.3s infinite;
  }

  @keyframes scroll {
    100% {
      opacity: 0;
      top: 27px;
    }
  }

  .manny-img {
    background: linear-gradient(to right, rgba(245, 245, 245, 0.3), rgba(245, 245, 245, 0.3)), url(/images/manny-img.webp);
    background-size: cover;
    background-position: center;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }

  @media only screen and (min-width: 601px) {
    .hero-actions .button {
      padding: 1rem 3.5rem;
      font-size: 20px;
    }
  }
</style>

<script>
  // Hide the scroll hint once the visitor has scrolled.
  const hero = document.getElementById('hero');
  window.addEventListener(
    'scroll',
    () => hero?.classList.toggle('scrolled', window.scrollY > 40),
    { passive: true }
  );

  // Quick "peek" of the photo on first load, so people discover the hover effect.
  const mannyImg = document.getElementById('manny-img');
  const heroH1 = document.getElementById('h1-hero');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (mannyImg && heroH1 && !reduceMotion) {
    const steps: Array<[number, () => void]> = [
      [1000, () => mannyImg.classList.add('animate-img')],
      [1500, () => heroH1.classList.add('animate-h1')],
      [1720, () => heroH1.classList.remove('animate-h1')],
      [1900, () => heroH1.classList.add('animate-h1')],
      [2120, () => heroH1.classList.remove('animate-h1')],
      [2400, () => mannyImg.classList.remove('animate-img')],
    ];
    steps.forEach(([delay, fn]) => setTimeout(fn, delay));
  }
</script>
