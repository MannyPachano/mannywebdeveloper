---
import { SHOW_CLOX } from '../config';

// Current roles, newest last. Clox stays behind SHOW_CLOX.
const now = [
  { org: 'TimeClick', role: 'Front-End Developer, Designer and Marketing/SEO Consultant', since: 'Since 2024' },
  { org: 'Universal Environmental Services', role: 'Web Developer, Designer and Marketing/SEO Consultant', since: 'Since 2026' },
  ...(SHOW_CLOX ? [{ org: 'Clox', role: 'Founder of a time-tracking app for field crews', since: 'Since 2026' }] : []),
];

// Four figures, each with a label that reads on its own.
const stats = [
  { value: '30,000+', label: 'Monthly organic visits to TimeClick at the end of my SEO program, up from about 4,000' },
  { value: '53', label: 'UES facilities on the locations page I designed and built' },
  { value: '28', label: 'UES state pages built from one template and two data files' },
  { value: '2019', label: 'The year I started designing and building websites for US clients' },
];
---

<section class="h-hero" aria-labelledby="hero-title">
  <div class="container h-hero-grid">
    <div>
      <p class="h-label">Web designer, front-end developer and SEO consultant</p>
      <h1 class="h-h1" id="hero-title">
        I design and build websites for software companies and small businesses, and I run the SEO behind them.
      </h1>
      <p class="h-p h-hero-lede">
        I make the mockups, write the code and handle the CRM, checkout and email systems the site connects to. I have
        worked with US clients since 2019.
      </p>
      <div class="h-hero-actions">
        <a class="h-btn h-btn-primary" href="/#project-section">See the case studies</a>
        <a class="h-btn h-btn-line" href="/#contact-section">Contact me</a>
      </div>
    </div>

    <aside aria-labelledby="now-title">
      <p class="h-label" id="now-title">Current work</p>
      <ul class="h-now">
        {now.map((item) => (
          <li>
            <span class="h-now-org">{item.org}</span>
            <span class="h-now-role">{item.role}</span>
            <span class="h-label">{item.since}</span>
          </li>
        ))}
      </ul>
      <div class="h-now-links">
        <a class="h-link" href="/files/Manny_Pachano_Resume.pdf">Download my resume (PDF)</a>
        <a class="h-link" href="https://www.linkedin.com/in/manny-pachano" target="_blank" rel="noopener noreferrer">
          LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </aside>
  </div>
</section>

<section aria-label="Results from my client work">
  <div class="container">
    <ul class="h-stats">
      {stats.map((stat) => (
        <li class="h-stat">
          <span class="h-stat-value">{stat.value}</span>
          <span class="h-stat-label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
