<section class="hero-section" id="hero" aria-labelledby="h1-hero">
  <div class="hero-content">
    <h1 id="h1-hero">Hey, I'm Manny Pachano</h1>
    <p class="lede hero-lede">
      I'm a front-end developer and marketing specialist. I build websites for software companies and small
      businesses, and I handle the SEO, email and CRM work behind them. I've worked with US clients since 2019.
    </p>
    <div class="hero-actions">
      <a class="button" href="/#project-section">See my work</a>
      <a class="button button-secondary" href="/#contact-section">Get in touch</a>
    </div>
    <p class="hero-proof">
      Recent work: TimeClick, Universal Environmental Services, nuVector and several small businesses in the US.
    </p>
  </div>

  <div class="mouse-section" aria-hidden="true">
    <div class="mouse"></div>
  </div>
</section>

<style>
  .hero-section {
    height: calc(100vh - var(--nav-height));
    min-height: 36.5rem;
    background: linear-gradient(to right, var(--page-wash), var(--page-wash)), url(/images/common-bg.svg);
    position: relative;
    min-width: 320px;
  }

  .hero-content {
    text-align: center;
    width: 92%;
    max-width: 45rem;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .hero-lede {
    margin: 0 auto;
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-top: 2.75rem;
  }

  @media only screen and (max-width: 600px) {
    .hero-actions .button {
      width: 100%;
      max-width: 22rem;
    }
  }

  .hero-proof {
    margin: 2rem auto 0;
    max-width: 34rem;
    font-size: 0.9rem;
    letter-spacing: 0.6px;
    color: var(--text-accent);
  }

  .mouse-section {
    position: absolute;
    bottom: 3%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 0;
    transition: opacity 0.3s var(--ease);
  }

  /* The thread starts from this hint, so it stays once the visitor scrolls;
     only the moving dot inside it stops. */
  .hero-section.scrolled .mouse::before {
    animation-play-state: paused;
    opacity: 0;
  }

  .mouse {
    width: 25px;
    height: 40px;
    border: 2px solid var(--text-subheader);
    border-radius: 60px;
    position: relative;
    overflow: hidden;
  }

  .mouse::before {
    content: '';
    width: 5px;
    height: 5px;
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--text-subheader);
    border-radius: 50%;
    opacity: 1;
    animation: scroll 1.3s infinite;
  }

  @keyframes scroll {
    100% {
      opacity: 0;
      top: 27px;
    }
  }

</style>

<script>
  // Stop the scroll hint moving once the visitor has scrolled; the thread starts from it.
  const hero = document.getElementById('hero');
  window.addEventListener(
    'scroll',
    () => hero?.classList.toggle('scrolled', window.scrollY > 40),
    { passive: true }
  );
</script>
