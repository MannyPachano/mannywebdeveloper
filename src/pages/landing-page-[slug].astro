---
// Walkthrough page for one landing page. Every entry in
// src/data/landing-pages.ts gets a page at /landing-page-<slug>.
import WalkthroughPage from '../components/WalkthroughPage.astro';
import { landingPages } from '../data/landing-pages';
import type { LandingPage } from '../data/landing-pages';

export function getStaticPaths() {
  return landingPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
  page: LandingPage;
}

const { page } = Astro.props;
---

<WalkthroughPage page={page} />
