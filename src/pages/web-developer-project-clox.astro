---
import WalkthroughPage from '../components/WalkthroughPage.astro';
import { projectWalkthroughs } from '../data/project-walkthroughs';
import { SHOW_CLOX } from '../config';

// Temporary project. When SHOW_CLOX is false the card disappears from the
// homepage and this URL becomes a redirect to the homepage at build time.
if (!SHOW_CLOX) return Astro.redirect('/');

const page = projectWalkthroughs.find((entry) => entry.slug === 'clox');
if (!page) throw new Error('Clox entry missing from src/data/project-walkthroughs.ts');
---

<WalkthroughPage page={page} />
