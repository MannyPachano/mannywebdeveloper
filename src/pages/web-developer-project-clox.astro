---
import CaseStudyLayout from '../layouts/CaseStudyLayout.astro';
import { SHOW_CLOX } from '../config';

// Temporary project. When SHOW_CLOX is false the card disappears from the
// homepage and this URL becomes a redirect to the homepage at build time.
if (!SHOW_CLOX) return Astro.redirect('/');
---

<CaseStudyLayout
  title="Clox"
  description="My own product: time tracking for small field crews in the trades. Native iOS and Android apps, a web dashboard and a marketing site, designed, built and marketed by me."
  client="Clox (my own company)"
  role="Founder: product, design, front end & marketing"
  year="2026 to present"
  liveUrl="https://getclox.com"
  liveLabel="Visit getclox.com"
  slides={[
    {
      title: 'Homepage: the pitch',
      src: '/videos/web-development-project-clox-intro.mp4',
      poster: '/images/clox-intro.webp',
    },
    {
      title: 'Homepage: features',
      src: '/videos/web-development-project-clox-features.mp4',
      poster: '/images/clox-features.webp',
    },
    {
      title: 'Homepage: pricing',
      src: '/videos/web-development-project-clox-pricing.mp4',
      poster: '/images/clox-pricing.webp',
    },
    {
      title: 'App: crew time tracking',
      src: '/images/clox-app-tracking.webp',
      poster: '/images/clox-app-tracking.webp',
      type: 'image',
      alt: 'Clox reports dashboard on a laptop showing 383 hours by employee, with the mobile clock-in screen beside it. Headline: time tracking built for crews on the job.',
    },
    {
      title: 'App: one-tap clock-in',
      src: '/images/clox-app-clock-in.webp',
      poster: '/images/clox-app-clock-in.webp',
      type: 'image',
      alt: 'Two phones showing the Clox clock-in screen; the second one blocks the punch because the worker is outside the job site. Headline: one tap to clock in from the field, off-site punches are blocked.',
    },
    {
      title: 'App: job site map',
      src: '/images/clox-app-map.webp',
      poster: '/images/clox-app-map.webp',
      type: 'image',
      alt: 'Clox team roster on a laptop and phone with every clock-in pinned on a map of job sites.',
    },
    {
      title: 'App: scheduling',
      src: '/images/clox-app-schedule.webp',
      poster: '/images/clox-app-schedule.webp',
      type: 'image',
      alt: 'Clox weekly schedule grid on a laptop with the same schedule on a phone. Headline: drag and drop shifts across days and people.',
    },
    {
      title: 'App: approvals',
      src: '/images/clox-app-approvals.webp',
      poster: '/images/clox-app-approvals.webp',
      type: 'image',
      alt: 'Clox team page with pending approvals on a laptop, and the approvals list on a phone. Headline: approve shifts and time off requests on the go.',
    },
    {
      title: 'App: overtime alerts',
      src: '/images/clox-app-overtime.webp',
      poster: '/images/clox-app-overtime.webp',
      type: 'image',
      alt: 'Clox report showing hours by employee with overtime highlighted and a labor cost total. Headline: spot overtime before it becomes a payroll surprise.',
    },
  ]}
  highlights={[
    { value: '$29 a month', label: 'Flat price, three users included, then $6 per user' },
    { value: 'iOS, Android, web', label: 'Native apps for the crew, a dashboard for the office' },
    { value: '14-day trial', label: 'No credit card, no sales call, no onboarding fee' },
  ]}
  overview={[
    'Small trades crews still run payroll off paper timecards and text threads: electricians, plumbers, HVAC techs, landscapers, general contractors. The hours live in someone\'s truck until Friday, and nobody trusts the totals. Clox fixes the record at the source. <strong>The crew clocks in from their phones, the office gets accurate hours, job costs and a schedule everyone can see, and payroll stops being a reconstruction.</strong> I founded it and I own product, design, front end and marketing.',
    'The product is a native iOS and Android app for the field plus a web dashboard for the office. Clock-ins are GPS and geofence aware, so a punch from outside the job site is blocked instead of argued about later. Overtime and break rules are applied automatically, every job carries its real labor cost, and payroll exports go straight to QuickBooks, ADP, Gusto or Paychex. Managers get drag-and-drop scheduling, one-tap approvals for shifts and time off, and a map of the day\'s clock-ins. When a dispute comes up, the record can be exported as a signed PDF.',
    'The marketing site at getclox.com is built the way I build client sites: one clear promise up top ("stop chasing paper timecards"), the problem and the fix in plain trade language, a feature grid, a "see it in action" tour of the real product, three steps to start, an "is this you?" list of trades, one price, one call to action. Behind it sits a growing blog written from search data, app store listings, directory profiles and a Product Hunt launch.',
    'Running my own product means I live with every decision a client site makes: positioning, pricing, onboarding, SEO, support. That loop is the best training I have for building websites that actually have to sell something.',
  ]}
  tools={['Next.js', 'TypeScript', 'React', 'Native mobile apps', 'Figma', 'SEO', 'Product Hunt']}
/>
